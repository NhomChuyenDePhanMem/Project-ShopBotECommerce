Project ProjectShopBotEcommerce {
  database_type: "PostgreSQL"
  Note: "ERD cho mini project Quan ly Quan An"
}

Table roles {
  id int [pk, increment]
  name varchar(50) [not null, unique]
}

Table users {
  id int [pk, increment]
  role_id int [not null, ref: > roles.id]
  full_name varchar(120) [not null]
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  phone varchar(20)
  created_at timestamp [not null]
}

Table dining_tables {
  id int [pk, increment]
  table_code varchar(20) [not null, unique]
  capacity int [not null]
  status varchar(20) [not null, note: "available|occupied|reserved"]
}

Table categories {
  id int [pk, increment]
  name varchar(100) [not null, unique]
}

Table menu_items {
  id int [pk, increment]
  category_id int [not null, ref: > categories.id]
  name varchar(120) [not null]
  description text
  price decimal(12,2) [not null]
  is_available boolean [not null, default: true]
  created_at timestamp [not null]
}

Table orders {
  id int [pk, increment]
  table_id int [ref: > dining_tables.id]
  created_by int [not null, ref: > users.id]
  customer_name varchar(120)
  order_type varchar(20) [not null, note: "dine_in|takeaway|delivery"]
  status varchar(20) [not null, note: "pending|processing|served|paid|cancelled"]
  ordered_at timestamp [not null]
  note text
}

Table order_items {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  menu_item_id int [not null, ref: > menu_items.id]
  quantity int [not null]
  unit_price decimal(12,2) [not null]
  item_note text
}

Table payments {
  id int [pk, increment]
  order_id int [not null, unique, ref: > orders.id]
  payment_method varchar(20) [not null, note: "cash|card|transfer|e_wallet"]
  amount decimal(12,2) [not null]
  paid_at timestamp [not null]
  status varchar(20) [not null, note: "success|failed|refunded"]
  transaction_ref varchar(100)
}

Table reservations {
  id int [pk, increment]
  table_id int [not null, ref: > dining_tables.id]
  customer_name varchar(120) [not null]
  customer_phone varchar(20) [not null]
  reserved_time timestamp [not null]
  party_size int [not null]
  status varchar(20) [not null, note: "booked|checked_in|cancelled|completed"]
  created_at timestamp [not null]
}
