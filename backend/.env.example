PORT=3000

# development | production (production bật kiểm tra JWT_SECRET, tắt TYPEORM_SYNC)
# NODE_ENV=development

# Gốc CORS được phép (phân tách bằng dấu phẩy). Để trống = mặc định dev: Vite + API local.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# PostgreSQL (khớp docs/design/schema.sql)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=sshopbot
# Số kết nối tối đa trong pool (pg)
DB_POOL_MAX=10
SCHEMA_SQL_PATH=../docs/design/schema.sql

# Đồng bộ schema TypeORM (tắt trên production)
TYPEORM_SYNC=true

# JWT
JWT_SECRET=thay-bang-chuoi-bi-mat-dai
JWT_EXPIRES_SEC=86400

# Chatbot AI provider
# CHATBOT_PROVIDER=openai | gemini | rule_based
CHATBOT_PROVIDER=gemini
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
# Bat de test fallback
CHATBOT_FORCE_DOWN=false

# Tài khoản seed khi bảng users trống (bcrypt)
SEED_ADMIN_USERNAME=admin01
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_FULL_NAME=Quản trị (seed)
SEED_SELLER_USERNAME=seller01
SEED_SELLER_PASSWORD=Seller@123
SEED_SELLER_FULL_NAME=Người bán (seed)
SEED_CUSTOMER_USERNAME=customer01
SEED_CUSTOMER_PASSWORD=Customer@123
SEED_CUSTOMER_FULL_NAME=Khách hàng (seed)
